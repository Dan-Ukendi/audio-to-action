# Copy this file to .env and adjust. .env is never committed.

# --- Transcription (faster-whisper) ---
# tiny | base | small | medium | large-v3 | large-v3-turbo
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# int8 is good on CPU; float16 on GPU
WHISPER_COMPUTE_TYPE=int8
# CPU threads for Whisper; 0 = library default (4). 8 measured ~25% faster on this i5 (8 cores).
WHISPER_CPU_THREADS=8

# --- Analysis (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Prompt version from shared/analyze.py PROMPTS (v2 = evaluated default, v3 = Phase 6 experiment)
ANALYSIS_PROMPT=v2

# --- Notifications (ntfy, Phase 4) ---
# Pick a long, hard-to-guess topic name: anyone who knows it can read the messages.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=change-me-to-something-random
# 1 = print pushes instead of sending them. Set to 0 once NTFY_TOPIC is a real, random topic.
NTFY_DRY_RUN=1
