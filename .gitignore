# --- Privacy: voicemails contain other people's personal data (GDPR) ---
# Never commit audio, transcripts, results or the database.

# Audio files, anywhere in the repo
*.wav
*.mp3
*.m4a
*.ogg
*.oga
*.opus
*.flac
*.aac
*.amr
*.wma
*.webm
*.3gp

# Pipeline working folders: ignore contents, keep the folder (.gitkeep)
01-voicemail-triage/inbox/*
01-voicemail-triage/processed/*
01-voicemail-triage/failed/*
01-voicemail-triage/transcripts/*
01-voicemail-triage/results/*
01-voicemail-triage/logs/
01-voicemail-triage/digests/
!01-voicemail-triage/**/.gitkeep
02-meeting-action-agent/inbox/*
02-meeting-action-agent/processed/*
02-meeting-action-agent/failed/*
02-meeting-action-agent/transcripts/*
02-meeting-action-agent/results/*
02-meeting-action-agent/logs/
02-meeting-action-agent/testset/audio/
02-meeting-action-agent/testset/transcripts/
02-meeting-action-agent/testset/results/
02-meeting-action-agent/testset/traces_*/
!02-meeting-action-agent/**/.gitkeep

# Test set: scripts.json + labels.json + generate.py ARE committed;
# generated audio and the downloaded TTS voice are not (regenerate with generate.py).
01-voicemail-triage/testset/audio/
01-voicemail-triage/testset/voices/
01-voicemail-triage/testset/transcripts/
01-voicemail-triage/testset/results/
*.onnx
# Your own real recordings: real people's data, never committed
01-voicemail-triage/testset/my_recordings/

# Databases
*.db
*.sqlite
*.sqlite3

# Secrets
.env

# Python
.venv/
__pycache__/
.pytest_cache/
*.pyc

# Model caches, if ever placed in the repo
models/

